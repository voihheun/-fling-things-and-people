local skyButtons = {}
local function applySky(name)
    local s = skies[name]
    tween(Lighting, 0.8, {
        ClockTime = s.time,
        Ambient = s.ambient,
        OutdoorAmbient = s.outdoor,
        Brightness = s.brightness,
    })
    atmo.Color = s.atmoColor
    atmo.Decay = s.atmoDecay
    atmo.Density = s.density
    atmo.Haze = 1
    atmo.Glare = 0.3
    sky.StarCount = s.stars
    cc.TintColor = s.tint
    for n, b in pairs(skyButtons) do
        setActive(b, n == name)
    end
end

