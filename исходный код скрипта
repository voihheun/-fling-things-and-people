local order = 0
local function nextOrder()
    order += 1
    return order
end

local function makeButton(text)
    local b = Instance.new("TextButton")
    b.LayoutOrder = nextOrder()
    b.Size = UDim2.new(1, 0, 0, 36)
    b.BackgroundColor3 = C.btn
    b.Font = Enum.Font.GothamMedium
    b.Text = text
    b.TextSize = 14
    b.TextColor3 = C.text
    b.AutoButtonColor = false
    b.Parent = content
    corner(b, UDim.new(0, 10))
    b.MouseEnter:Connect(function()
        tween(b, 0.15, {BackgroundColor3 = C.btnHov})
    end)
    b.MouseLeave:Connect(function()
        tween(b, 0.15, {BackgroundColor3 = b:GetAttribute("Active") and C.on or C.btn})
    end)
    return b
end

local function setActive(b, state)
    b:SetAttribute("Active", state)
    tween(b, 0.2, {BackgroundColor3 = state and C.on or C.btn})
end

