-- ========== РЎР’РћР РђР§РР’РђРќРР• ==========
local collapsed = false
local busy = false
local BUBBLE = 54

local function collapse()
    if busy or collapsed then return end
    busy = true
    collapsed = true
    tween(main, 0.25, {Size = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    task.wait(0.25)
    main.Visible = false
    bubble.Visible = true
    tween(bubble, 0.3, {Size = UDim2.new(0, BUBBLE, 0, BUBBLE)}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    task.wait(0.3)
    busy = false
end

local function expand()
    if busy or not collapsed then return end
    busy = true
    collapsed = false
    tween(bubble, 0.2, {Size = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    task.wait(0.2)
    bubble.Visible = false
    main.Visible = true
    tween(main, 0.3, {Size = UDim2.new(0, 250, 0, 330)}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    task.wait(0.3)
    busy = false
end

minBtn.MouseButton1Click:Connect(function() task.spawn(collapse) end)
bubble.MouseButton1Click:Connect(function() task.spawn(expand) end)

